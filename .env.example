# Backend API — misma red WiFi que el teléfono
# El backend imprime la IP al arrancar (npm run dev en backend-asistente-personal)
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000/api

# Supabase — uploads directos de avatar desde el frontend
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# OAuth — Google Sign-In (Google Cloud Console)
# Web client ID es obligatorio. iOS/Android son opcionales para builds nativos.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Chat: POST /api/chat (mismo backend; OpenAI solo en el servidor)
# Voz: POST /api/audio + worker (npm run worker:dev / npm run dev:all)

# Emulador Android: http://10.0.2.2:3000/api
# Emulador web / iOS Simulator: http://localhost:3000/api

# Checkout Mercado Pago (opcional — plan Pro)
# EXPO_PUBLIC_MERCADOPAGO_CHECKOUT_URL=https://www.mercadopago.com/...

# --- Expo Go (diario) vs APK / notificaciones nativas ---
# Por defecto NO pongas EXPO_PUBLIC_NATIVE_BUILD: widgets, notificaciones locales
# y quick actions quedan desactivados para que Expo Go cargue bien.
# npm start / npm run start:clean → Expo Go en puerto 8081.
#
# Para probar APK / development build al 100% (notificaciones + widgets), descomenta:
# EXPO_PUBLIC_NATIVE_BUILD=1
# (EAS ya lo setea en eas.json; localmente reinstala expo-dev-client si usas development build)
