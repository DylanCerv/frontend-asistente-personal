# Backend API (emulador / web en la misma PC)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Dispositivo físico con Expo Go (usa la IP de tu PC, no localhost)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000/api

# OpenAI API key for Whisper speech-to-text (opcional, si no usas el backend)
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-key-here

# Optional: custom Whisper endpoint (defaults to OpenAI)
# EXPO_PUBLIC_WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# EXPO_PUBLIC_WHISPER_MODEL=whisper-1
# EXPO_PUBLIC_WHISPER_LANGUAGE=es

# Assistant AI endpoint (POST JSON, see src/types/api.ts)
EXPO_PUBLIC_ASSISTANT_API_URL=https://your-api.com/assistant/chat

# Mercado Pago checkout (Ecuador) — suscripción Pro y paquetes de cursos
# EXPO_PUBLIC_MERCADOPAGO_CHECKOUT_URL=https://www.mercadopago.com.ec/subscriptions/checkout?preapproval_plan_id=YOUR_PLAN_ID
# EXPO_PUBLIC_MERCADOPAGO_COURSE_URL=https://www.mercadopago.com.ec/checkout/v1/YOUR_COURSE_PAYMENT
